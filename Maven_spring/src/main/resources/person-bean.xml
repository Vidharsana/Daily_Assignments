<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context" xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">


	<context:property-placeholder location="classpath:data.properties"/>

    <bean name="p" class="com.mph.beans.Person" scope="prototype">
   
  <!--  <constructor-arg name="id" value="123"></constructor-arg>
   <constructor-arg name="name" value="vidhu"></constructor-arg>
   <constructor-arg name="age" value="21"></constructor-arg>
   <constructor-arg name="address" ref="addr"></constructor-arg> -->
   
   <property name="id" value="${Person.id}"></property>
   <property name="name" value="${Person.name}"></property>
   <property name="age" value="${Person.age}"></property>
   <property name="address" ref="addr"></property>
   
   	 <property name="langs">
   <list>
   	<value>#{'${Person.langs}'.split(',')}</value>
   	<!-- <value>Tamil</value>
   	<value>Baduga</value> -->
   </list>
   </property> 
   
   
    </bean>

	
	 <bean name="addr" class="com.mph.beans.Address">
   
  <!--  <constructor-arg name="addrId" value="1"></constructor-arg>
   <constructor-arg name="city" value="The Nilgiris"></constructor-arg>
   <constructor-arg name="state" value="Tamil Nadu"></constructor-arg> -->
   
   <property name="addrId" value="${Address.addrId}"></property>
   <property name="city" value="${Address.city}"></property>
   <property name="state" value="${Address.state}"></property>
   
    </bean>
</beans>